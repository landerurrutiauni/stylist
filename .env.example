# FOLIA: copia este archivo a .env para desarrollo local (cp .env.example .env).
# .env está en .gitignore. Aquí solo hay valores de ejemplo, ninguna credencial.

# ─── Navegador (público) ─────────────────────────────────────────────────────
# Lo único que el navegador conoce: la URL pública de la API. Todo lo que
# empieza por VITE_ termina dentro del JavaScript publicado; nunca pongas aquí
# una clave.
VITE_API_BASE_URL=http://localhost:8787

# ─── Servidor (secreto, solo backend) ────────────────────────────────────────
# Clave de la API de Anthropic (console.anthropic.com). Sin ella, /health
# responde "missing_api_key" y la web ofrece el modo demostración.
ANTHROPIC_API_KEY=
# Modelo con visión. Por defecto: claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento: low | medium | high | xhigh | max. Por defecto: medium.
ANTHROPIC_EFFORT=medium
# Tokens máximos de salida (4000–64000). Por defecto: 24000.
ANTHROPIC_MAX_TOKENS=24000
# Tiempo máximo de una petición al modelo, en ms (20000–280000). Por defecto: 120000.
ANTHROPIC_TIMEOUT_MS=120000
# "off" desactiva el relevo automático a otro modelo si el principal rechaza la petición.
ANTHROPIC_FALLBACKS=default

# Simulación del corte sobre la foto (opcional). Gratis con Cloudflare Workers AI:
# cuenta gratuita en dash.cloudflare.com › Workers AI › Use REST API, que da el
# Account ID y crea el token. Cuota gratuita diaria; Cloudflare no conserva las fotos.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Alternativa de pago: Google Gemini (aistudio.google.com/api-keys, con facturación).
GEMINI_API_KEY=
IMAGE_MODEL=gemini-nano-banana-2.1
# Si están las dos, se usa Cloudflare; "google" fuerza Gemini.
IMAGE_PROVIDER=

# Orígenes que pueden llamar a la API, separados por comas (sin barra final).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# "false" acepta peticiones sin cabecera Origin (no recomendado en producción).
REQUIRE_ORIGIN=true

# Límites de uso.
RATE_LIMIT_PER_HOUR=6
DAILY_ANALYSIS_LIMIT=150
PREVIEW_PER_HOUR=10
PREVIEW_DAILY_LIMIT=200
PREVIEW_TIMEOUT_MS=90000
# Sal para cifrar (SHA-256) las direcciones IP antes de contarlas. Pon una cadena larga y aleatoria.
RATE_LIMIT_SALT=cambia-esto-por-una-cadena-aleatoria
# "memory" ignora la tabla de Supabase y cuenta solo en memoria.
RATE_LIMIT_STORE=

# Puerto del servidor local (npm run dev:api).
PORT=8787
