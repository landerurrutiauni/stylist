{
  "name": "folia",
  "private": true,
  "version": "0.1.0",
  "description": "FOLIA — tu estilista personal: análisis de dos fotos y un cuestionario para recomendar cortes cortos, medios y largos.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/node/dev-server.ts",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs dist && node scripts/check-dist-secrets.mjs dist",
    "build:edge": "node scripts/build-edge.mjs",
    "preview": "vite preview",
    "serve:pages": "node scripts/pages-server.mjs --dir dist --base /stylist/ --port 4321",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:dist": "node scripts/check-dist-secrets.mjs dist",
    "fixtures": "node scripts/make-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:e2e": "vite build --outDir dist-e2e --emptyOutDir && node scripts/postbuild.mjs dist-e2e && node scripts/check-dist-secrets.mjs dist-e2e"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.136.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.8.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
